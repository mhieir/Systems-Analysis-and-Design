' --- Data Access Layer ---
abstract class BaseRepository<T> {
    # items: Map<Long, T>
    + save(item: T)
    + findById(id: Long): T
    + findAll(): List<T>
}

class StudentRepository {
}

class CourseRepository {
}

class CourseGroupRepository {
}

' --- Relationships ---
BaseRepository <|-- StudentRepository : <Student>
BaseRepository <|-- CourseRepository : <Course>
BaseRepository <|-- CourseGroupRepository : <CourseGroup>

BaseRepository ..> Entity : stores

